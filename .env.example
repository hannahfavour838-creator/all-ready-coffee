# ─── All Ready Coffee — environment ─────────────────────────────────────────
# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for metadata, sitemap, CSRF origin checks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database. Leave empty to use the embedded PostgreSQL (PGlite) stored in ./.data/pglite.
# For production point this at a managed PostgreSQL instance (Neon, Supabase, RDS, ...):
# DATABASE_URL=postgres://app_user:strong-password@host:5432/allready?sslmode=require
DATABASE_URL=

# Secret used to sign short-lived tokens (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Seed accounts (demo). In production the seed refuses to run without explicit passwords.
SEED_ADMIN_EMAIL=owner@allreadycoffee.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
